# Secrets for pocketone.yaml's $NAME references.
#
# This file is private to the process: it is used only to expand $NAME references in pocketone.yaml, and is never
# written into the environment. The app and its JS hooks read a value only if its name is listed in app.env_allow.
#
# Examples:
# PB_ENCRYPTION_KEY=change-me-to-32-characters-minimum
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
